# Find API definitions in 'api/'.
generate api/

# Generated backend and frontend clients.
generate --python=backend/api/
generate --react=frontend/api
generate --web=frontend/api

# Watch source files during `rbt dev run`.
dev run --watch=backend/**/*.py
dev run --watch=api/**/*.py

# Tell `rbt` that this is a Python application.
dev run --python

# Save local durable state between restarts.
dev run --application-name=reboot-event-predictions
dev expunge --application-name=reboot-event-predictions

# Load local secrets from a git-ignored env file.
dev run --env-file=.env

# Run the application.
dev run --application=backend/src/main.py

# Serve both MCP UIs and the standalone web SPA through one frontend tree.
dev run --default-config=hmr
dev run --frontend-root-path=frontend
dev run:hmr --frontend-host=http://localhost:4444
dev run:dist --frontend-dist-path=frontend/dist

# Production config.
serve run --python
serve run --frontend-dist-path=frontend/dist --frontend-root-path=frontend
serve run --application=backend/src/main.py
serve run --application-name=reboot-event-predictions
serve run --tls=external
